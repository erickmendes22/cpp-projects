#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
/* Mesa Turnip A8xx: translate Vulkan DGC token stream to PM4.
 * Draws use CP_DRAW_INDIRECT_MULTI (not CP_DRAW_INDX_OFFSET), which handles
 * vertexOffset/firstInstance, including shader driver parameter loading.
 * Output: twenty 32-bit words per generated sequence, contiguous IB payload.
 */
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(buffer_reference, std430, buffer_reference_align=4)
buffer WordBuffer { uint data[]; };
layout(push_constant, scalar) uniform Parameters {
    uint64_t indirect_address;
    uint64_t output_pm4_address;
    uint64_t sequence_count_address;
    uint maximum_count;
    uint indirect_stride;
    uint index_token_offset;
    uint constants_token_offset;
    uint draw_token_offset;
    uint shared_constant_register;
    uint unused_vertex_offset_register;
    uint draw_initiator_u16;
    uint draw_initiator_u32;
    uint push_mode;
    uint load_state6_opcode;
    uint load_state6_control;
    uint draw_packet_opcode;
    uint draw_opcode_and_vs_offset;
    uint64_t preprocess_source_address;
    uint first_sequence;
    uint active_sequences;
    uint mode;
} p;

uint parity(uint x) {
    x ^= x >> 16; x ^= x >> 8; x ^= x >> 4;
    return ((~0x6996u) >> (x & 15u)) & 1u;
}
uint pm4_pkt4(uint reg, uint count) {
    return 0x40000000u | count | (parity(count) << 7u)
           | ((reg & 0x3ffffu) << 8u) | (parity(reg) << 27u);
}
uint pm4_pkt7(uint op, uint count) {
    return 0x70000000u | count | (parity(count) << 15u)
           | ((op & 0x7fu) << 16u) | (parity(op) << 23u);
}
void main() {
    uint local_seq = gl_GlobalInvocationID.x;
    if (local_seq >= p.active_sequences) return;
    uint seq = local_seq + p.first_sequence;
    WordBuffer outpm4 =
        WordBuffer(p.output_pm4_address + uint64_t(local_seq) * 80ul);
    if (p.mode == 1u) {
        // vkCmdExecuteGeneratedCommandsEXT with isPreprocessed=VK_TRUE:
        // copy the prepared commands into GPU-writable draw stream slots.
        WordBuffer prepared =
            WordBuffer(p.preprocess_source_address + uint64_t(seq) * 80ul);
        for (uint i = 0u; i < 20u; ++i)
            outpm4.data[i] = prepared.data[i];
        return;
    }
    uint count = p.sequence_count_address == 0ul ? p.maximum_count :
        WordBuffer(p.sequence_count_address).data[0];
    uint64_t base = p.indirect_address +
                    uint64_t(seq) * uint64_t(p.indirect_stride);
    WordBuffer ib = WordBuffer(base + p.index_token_offset);
    WordBuffer pc = WordBuffer(base + p.constants_token_offset);
    uint64_t draw_address = base + p.draw_token_offset;

    uint format = ib.data[3];
    bool is16 = format == 57u; // DXGI_FORMAT_R16_UINT
    bool is32 = format == 42u; // DXGI_FORMAT_R32_UINT
    uint index_width = is16 ? 2u : 4u;
    uint64_t index_va = uint64_t(ib.data[0]) | (uint64_t(ib.data[1]) << 32u);
    bool live = seq < count && (is16 || is32) &&
                ((index_va & uint64_t(index_width - 1u)) == 0ul);

    uint at;
    if (p.push_mode == 0u) {
        // Per-pipeline IR3_PUSH_CONSTS_SHARED_PREAMBLE register bank.
        outpm4.data[0] = pm4_pkt4(p.shared_constant_register, 4u);
        for (uint i = 0u; i < 4u; ++i) outpm4.data[i + 1u] = pc.data[i];
        at = 5u;
    } else {
        // IR3_PUSH_CONSTS_SHARED: CP_LOAD_STATE6 direct-to-constant bank.
        outpm4.data[0] = pm4_pkt7(p.load_state6_opcode, 7u);
        outpm4.data[1] = p.load_state6_control;
        outpm4.data[2] = 0u;
        outpm4.data[3] = 0u;
        for (uint i = 0u; i < 4u; ++i) outpm4.data[i + 4u] = pc.data[i];
        at = 8u;
    }

    // CP_DRAW_INDIRECT_MULTI with indexed mode (9 DWORD payload).
    // The CP reads VkDrawIndexedIndirectCommand (20 bytes) directly; unlike
    // CP_DRAW_INDX_OFFSET this also applies VS driver parameters correctly.
    outpm4.data[at] = pm4_pkt7(p.draw_packet_opcode, 9u);
    outpm4.data[at + 1u] = is16 ? p.draw_initiator_u16 : p.draw_initiator_u32;
    outpm4.data[at + 2u] = p.draw_opcode_and_vs_offset;
    outpm4.data[at + 3u] = live ? 1u : 0u;
    outpm4.data[at + 4u] = live ? ib.data[0] : 0u;
    outpm4.data[at + 5u] = live ? ib.data[1] : 0u;
    outpm4.data[at + 6u] = live ? (ib.data[2] / index_width) : 0u;
    outpm4.data[at + 7u] = uint(draw_address);
    outpm4.data[at + 8u] = uint(draw_address >> 32u);
    outpm4.data[at + 9u] = 20u;

    // PM4 parser must see valid commands through the entire 80-byte record.
    uint tail = 20u - (at + 10u);
    outpm4.data[at + 10u] = pm4_pkt7(0x10u, tail - 1u); // CP_NOP
    for (uint i = at + 11u; i < 20u; ++i) outpm4.data[i] = 0u;
}
